{
  "name": "life-in-the-uk-prep",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node --experimental-strip-types scripts/record-release.ts",
    "start": "next start",
    "upgrade:next": "npx @next/codemod@latest upgrade next",
    "check-updates": "npx npm-check-updates -i",
    "analyze": "ANALYZE=true next build",
    "migrate": "node --experimental-strip-types --env-file=.env.local scripts/migrate.ts",
    "export:questions": "node --experimental-strip-types --env-file=.env.local scripts/export-questions.ts",
    "sync:questions": "node --experimental-strip-types --env-file=.env.local scripts/sync-questions.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@mui/x-charts": "^9.10.1",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
